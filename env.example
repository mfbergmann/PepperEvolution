# Pepper Robot Bridge
PEPPER_IP=10.0.100.100
# SSH login used by robot_bridge/deploy.py
PEPPER_USER=nao
PEPPER_PASSWORD=nao
BRIDGE_PORT=8888
BRIDGE_API_KEY=
BRIDGE_TIMEOUT=15
BRIDGE_ACTION_TIMEOUT=120
# Set to true to run everything without a robot (actions are logged, camera is simulated)
PEPPER_FAKE_BRIDGE=false

# What to do to the robot right after connecting
PREPARE_ON_CONNECT=true
# disabled = we drive the robot; keep = leave Autonomous Life as it is (solitary/interactive)
PEPPER_AUTONOMOUS_LIFE=disabled
# Optional posture to take after connecting, e.g. Stand
POSTURE_ON_CONNECT=
# Put the robot to rest (motors off) when the host application exits
REST_ON_EXIT=false

# AI Model Configuration
# Primary: Anthropic Claude (claude-opus-5 recommended; claude-sonnet-5 is cheaper/faster)
# Secondary: OpenAI (gpt-4o, ...)
AI_MODEL=claude-opus-5
# Reasoning effort for Claude 4.6+ models: low (snappy conversation), medium, high
AI_EFFORT=low
AI_MAX_TOKENS=16000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=

# Behaviour
# Speak the AI's replies aloud sentence by sentence as they stream in
SPEAK_RESPONSES=true
# Show what Pepper says on the chest tablet
TABLET_SUBTITLES=true
# React out loud when someone touches Pepper's head/hands or a bumper is pressed
REACT_TO_TOUCH=true
# Show what Pepper is doing with the eye colour: blue listening, purple thinking, white speaking
LED_STATE_SIGNALS=true
# Say a short filler ("Hmm.") when the model has produced nothing after this many seconds (0 = never)
BACKCHANNEL_AFTER=2.0
# On connect: true = head follows people and sounds (ALBasicAwareness, head only; NAOqi resumes it after every
# move_head, so "look left" only holds briefly); false = off; keep = leave as is. Try it from the UI/roadmap first.
PEPPER_AWARENESS=false

# Voice input (optional). none = typing only. sherpa = streaming recogniser (pip install -r requirements-voice.txt,
# STT_MODEL = directory of a sherpa-onnx streaming transducer model). whisper = faster-whisper per utterance
# (STT_MODEL = base, small, ...). fake = for tests.
STT_BACKEND=none
STT_MODEL=
STT_LANGUAGE=en
# Stream the robot's own microphone from the bridge (/ws/audio) and answer what people say near Pepper.
# The web UI's hold-to-talk button works whenever STT_BACKEND is set, with or without this.
VOICE_INPUT=false
# Save every recognised utterance as a WAV file here (for tuning recognition); empty = off
VOICE_RECORD_DIR=

# Host server (REST API + WebSocket + web UI on one port)
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=pepper_evolution.log
