# Pepper Robot Bridge
PEPPER_IP=10.0.100.100
# SSH login used by robot_bridge/deploy.py
PEPPER_USER=nao
PEPPER_PASSWORD=nao
BRIDGE_PORT=8888
BRIDGE_API_KEY=
BRIDGE_TIMEOUT=15
BRIDGE_ACTION_TIMEOUT=120
# Set to true to run everything without a robot (actions are logged, camera is simulated)
PEPPER_FAKE_BRIDGE=false

# What to do to the robot right after connecting
PREPARE_ON_CONNECT=true
# disabled = we drive the robot; keep = leave Autonomous Life as it is (solitary/interactive)
PEPPER_AUTONOMOUS_LIFE=disabled
# Optional posture to take after connecting, e.g. Stand
POSTURE_ON_CONNECT=
# Put the robot to rest (motors off) when the host application exits
REST_ON_EXIT=false

# AI Model Configuration
# Primary: Anthropic Claude (claude-sonnet-5-5 recommended: chosen for spoken turns on the robot; claude-opus-5-5 for harder reasoning)
# Secondary: OpenAI (gpt-4o, ...)
AI_MODEL=claude-sonnet-5-5
# Reasoning effort for Claude 4.6+ models: low (snappy conversation), medium, high
AI_EFFORT=medium
AI_MAX_TOKENS=16000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=
# Experimental: a local conversation model on an Ollama server, used when AI_MODEL is not claude-*/gpt-*
# (e.g. AI_MODEL=qwen3-vl:30b-a3b-instruct); not recommended yet, see docs/SETUP_PROFILES.md
OLLAMA_URL=

# Behaviour
# Speak the AI's replies aloud sentence by sentence as they stream in
SPEAK_RESPONSES=true
# Show what Pepper says on the chest tablet
TABLET_SUBTITLES=true
# React out loud when someone touches Pepper's head/hands or a bumper is pressed
REACT_TO_TOUCH=true
# Greet someone who walks up (within 3 m looking at Pepper, or 1.8 m) after nobody was in view for 20 s
GREET_NEWCOMERS=true
# Seconds between greetings
GREET_COOLDOWN=90
# Show what Pepper is doing with the eye colour: blue listening, purple thinking, white speaking
LED_STATE_SIGNALS=true
# Say a short filler ("Hmm.") when the model has produced nothing after this many seconds (0 = never)
BACKCHANNEL_AFTER=2.0
# On connect: true = head follows people and sounds (ALBasicAwareness, head only; NAOqi resumes it after every
# move_head, so "look left" only holds briefly); false = off; keep = leave as is. Try it from the UI/roadmap first.
PEPPER_AWARENESS=false

# Voice input (optional). none = typing only. sherpa = streaming recogniser (pip install -r requirements-voice.txt,
# STT_MODEL = directory of a sherpa-onnx streaming transducer model). whisper = faster-whisper per utterance
# (STT_MODEL = base, small, ...). fake = for tests.
STT_BACKEND=none
STT_MODEL=
STT_LANGUAGE=en
# Stream the robot's own microphone from the bridge (/ws/audio) and answer what people say near Pepper.
# The web UI's hold-to-talk button works whenever STT_BACKEND is set, with or without this.
VOICE_INPUT=false
# Initiative (src/ai/reflection.py): Pepper may say one short thing unprompted when someone lingers quietly or a
# question goes unanswered; at most once every 3 minutes; off until judged on the robot
INITIATIVE=false
# Wait up to 2.5 s more when an utterance clearly stops mid-sentence ("Can you", "...onto the") and join the rest (#26)
WAIT_FOR_UNFINISHED=true
# Save every recognised utterance as a WAV file here (for tuning recognition); empty = off
VOICE_RECORD_DIR=
# Save every photo Pepper takes here, with the measured head angle and sharpness (for testing; keep it out of git)
PHOTO_RECORD_DIR=
# One folder per run under here, holding the log, audio, photos, turns.jsonl and events.jsonl for review
# (overrides LOG_FILE, VOICE_RECORD_DIR and PHOTO_RECORD_DIR; keep it out of git)
SESSION_DIR=
# Sound direction (bridge 0.6+, ALSoundLocalization): each spoken turn gets the direction the voice came from
# ("come to me" when the camera cannot see the speaker); robot CPU cost not measured yet
SOUND_DIRECTION=false
# Long-term memory (docs/MEMORY.md): people who agreed to be remembered, facts, session episodes, in
# MEMORY_DIR/pepper.sqlite; personal data, keep it out of git (scripts/memory_admin.py manages it); empty = off
MEMORY_DIR=
# Situation judgements: fast local decision models (Ollama /v1/systemone, e.g. http://alien3:11435); empty = off
DECIDE_URL=
# Only answer open-microphone speech that seems meant for Pepper (needs DECIDE_URL)
ADDRESSEE_GATE=true
# Probability needed to answer (lower, 0.4, while someone is looking at Pepper)
ADDRESSEE_THRESHOLD=0.6
# Start head moves, gestures and turns in place at once from a spoken command; Claude does the words (needs DECIDE_URL)
ROUTER=true
# Probability needed to start an action without the model
ROUTER_THRESHOLD=0.7
# Camera judgements while someone is in view: is someone waving, showing something, facing Pepper? (needs DECIDE_URL)
VISION_STREAM=true
# Frames per second sent to the local vision model (the bridge caps it at 5)
VISION_FPS=1
# Scene notes (#11): every 20 s while someone is in view, who is where (Clef Flash) and a short note on the place
# from a small vision model on the same Ollama (needs: ollama pull qwen3.5:4b); adds a sentence to the state while
# fresh; off until tried on the robot; docs/MEMORY.md
SCENE_NOTES=false
SCENE_MODEL=qwen3.5:4b

# Host server (REST API + WebSocket + web UI on one port)
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=pepper_evolution.log
